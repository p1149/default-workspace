{
  "name": "@local/remote-control",
  "version": "1.0.0",
  "private": true,
  "description": "Remote Control: control the DSH UI from another device over HTTP (LAN).",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": false, "inject": [] }
  }
}
